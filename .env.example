# 複製成 .env 再填。.env 不會進版控。

# 公開網域。留空 = 本機模式（*.localhost）。
# 填了就是公開模式：cg.cgany.com → cg.<BASE_DOMAIN>、cgany.com → <BASE_DOMAIN>、cgany.itaiwan.net → itaiwan.<BASE_DOMAIN>，
# 並自動開啟 18 歲確認頁與遮 email、強制關閉會員個資頁。
BASE_DOMAIN=

# 子網域接法。留空 = 用點（cg.cgany.loveloli.org，兩層子網域，Cloudflare 免費憑證不涵蓋）；
# 填 - = 用連字號（cg-cgany.loveloli.org，一層子網域，免費的 *.loveloli.org 憑證就夠）。
SUBDOMAIN_SEP=

# 必填：資料夾所在目錄（cgany_archive、cgany_com_archive、cgany_build/override）在 WSL 裡的路徑
CGANY_DATA=/mnt/c/Users/<帳號>

# 用 docker compose --profile tunnel up -d 對外時才需要；從 Cloudflare Zero Trust 的 Tunnel 頁面複製
# CLOUDFLARE_TUNNEL_TOKEN=
